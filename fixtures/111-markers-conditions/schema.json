{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jotl.dev/fixtures/111.json",
  "$ref": "#/$defs/Settings",
  "x-ui": {
    "version": 1,
    "rules": [
      {
        "match": {
          "type": "boolean"
        },
        "ui": {
          "widget": "checkbox"
        }
      }
    ]
  },
  "$defs": {
    "Cities": {
      "title": "城市",
      "type": "string",
      "oneOf": [
        {
          "title": "北京",
          "const": "bj"
        },
        {
          "title": "上海",
          "const": "sh"
        },
        {
          "title": "广州",
          "const": "gz"
        }
      ]
    },
    "Shared": {
      "title": "公共",
      "type": "object",
      "properties": {
        "note": {
          "title": "备注",
          "type": "string"
        }
      }
    },
    "Settings": {
      "title": "设置",
      "description": "设置页",
      "type": "object",
      "properties": {
        "mode": {
          "title": "模式",
          "type": "string",
          "oneOf": [
            {
              "title": "基础",
              "const": "basic"
            },
            {
              "title": "专业",
              "const": "pro"
            }
          ],
          "default": "basic"
        },
        "level": {
          "title": "等级",
          "type": "integer",
          "minimum": 0,
          "maximum": 10,
          "default": 0
        },
        "city": {
          "$ref": "#/$defs/Cities",
          "title": "城市"
        },
        "cities": {
          "title": "常驻城市",
          "type": "array",
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/Cities"
          },
          "uniqueItems": true
        },
        "advanced": {
          "title": "高级选项",
          "type": "string",
          "x-ui": {
            "visibleIf": {
              "left": "mode",
              "op": "eq",
              "right": "pro"
            }
          }
        },
        "bonus": {
          "title": "奖励",
          "type": "string",
          "x-ui": {
            "visibleIf": {
              "op": "and",
              "conditions": [
                {
                  "left": "level",
                  "op": "gte",
                  "right": 5
                },
                {
                  "left": "level",
                  "op": "lt",
                  "right": 9
                }
              ]
            }
          }
        },
        "warn": {
          "title": "警告",
          "type": "string",
          "x-ui": {
            "visibleIf": {
              "op": "or",
              "conditions": [
                {
                  "left": "level",
                  "op": "gt",
                  "right": 8
                },
                {
                  "left": "level",
                  "op": "lte",
                  "right": 0
                }
              ]
            }
          }
        },
        "quiet": {
          "title": "静默",
          "description": "未选城市时显示",
          "type": "string",
          "x-ui": {
            "visibleIf": {
              "left": "city",
              "op": "truthy",
              "right": false
            }
          }
        },
        "links": {
          "title": "链接",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "url": {
                "title": "地址",
                "type": "string",
                "format": "uri"
              },
              "open": {
                "title": "打开",
                "type": "boolean"
              },
              "target": {
                "title": "目标",
                "type": "string",
                "enum": [
                  "self",
                  "blank"
                ],
                "x-ui": {
                  "visibleIf": {
                    "base": "node",
                    "left": "open",
                    "op": "truthy",
                    "right": true
                  }
                }
              },
              "tip": {
                "title": "提示",
                "type": "string",
                "x-ui": {
                  "visibleIf": {
                    "op": "not",
                    "condition": {
                      "base": "node",
                      "left": "url",
                      "op": "in",
                      "right": [
                        "https://a.com"
                      ]
                    }
                  }
                }
              },
              "extra": {
                "title": "附加",
                "type": "string",
                "x-ui": {
                  "visibleIf": {
                    "left": "links[*].open",
                    "op": "truthy",
                    "right": true
                  }
                }
              }
            },
            "required": [
              "url"
            ]
          },
          "x-ui": {
            "summary": "url"
          }
        }
      },
      "required": [
        "mode",
        "level"
      ]
    }
  }
}
