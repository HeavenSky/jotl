Constraints: {
  title(标题): string[minLength: 1, maxLength: 20, default: '欢迎']
  code: string[pattern: '^[a-z]+$']
  email?: email
  price(价格): number[minimum: 0, exclusiveMaximum: 10000, default: 9.5, schema: {multipleOf: 0.5}]
  count: integer[minimum: 1, maximum: 10, default: 1]
  tags: array[array_item: 'string', minItems: 1, maxItems: 3, uniqueItems: true, default: ['a']]
}
