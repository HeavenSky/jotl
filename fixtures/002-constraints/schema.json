{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/Constraints",
  "x-ui": {
    "version": 1
  },
  "$defs": {
    "Constraints": {
      "type": "object",
      "properties": {
        "title": {
          "title": "标题",
          "type": "string",
          "minLength": 1,
          "maxLength": 20,
          "default": "欢迎"
        },
        "code": {
          "type": "string",
          "pattern": "^[a-z]+$"
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "price": {
          "title": "价格",
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 10000,
          "multipleOf": 0.5,
          "default": 9.5
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "default": 1
        },
        "tags": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "default": [
            "a"
          ]
        }
      },
      "required": [
        "title",
        "code",
        "price",
        "count",
        "tags"
      ]
    }
  }
}
