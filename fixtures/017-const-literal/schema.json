{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/Consts",
  "x-ui": {
    "version": 1
  },
  "$defs": {
    "Consts": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "banner"
        },
        "version": {
          "type": "integer",
          "const": 2
        },
        "enabled": {
          "type": "boolean",
          "const": true
        },
        "only": {
          "type": "string",
          "const": "fixed"
        }
      },
      "required": [
        "kind",
        "version",
        "enabled",
        "only"
      ]
    }
  }
}
