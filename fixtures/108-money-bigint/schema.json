{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/Pricing",
  "x-ui": {
    "version": 1
  },
  "$defs": {
    "Pricing": {
      "title": "定价",
      "type": "object",
      "properties": {
        "price": {
          "title": "价格",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "money"
            },
            "value": {
              "type": "string",
              "pattern": "^-?\\d+\\.\\d{2}$"
            },
            "currency": {
              "type": "string",
              "const": "CNY"
            },
            "unit": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "value",
            "currency"
          ],
          "additionalProperties": false,
          "x-decimalRange": {
            "minimum": "0"
          }
        },
        "deposit": {
          "title": "押金",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "money"
            },
            "value": {
              "type": "string",
              "pattern": "^-?\\d+(\\.\\d+)?$"
            },
            "currency": {
              "type": "string",
              "enum": [
                "USD",
                "JPY"
              ]
            },
            "unit": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "value",
            "currency"
          ],
          "additionalProperties": false,
          "x-ui": {
            "thousands": false
          }
        },
        "cost": {
          "title": "成本",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "money"
            },
            "value": {
              "type": "string",
              "pattern": "^-?\\d+$"
            },
            "currency": {
              "type": "string",
              "const": "CNY"
            },
            "unit": {
              "type": "string",
              "const": "fen"
            }
          },
          "required": [
            "type",
            "value",
            "currency",
            "unit"
          ],
          "additionalProperties": false
        },
        "fee": {
          "title": "手续费",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "money"
            },
            "value": {
              "type": "string",
              "pattern": "^-?\\d+(\\.\\d+)?$"
            },
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            },
            "unit": {
              "type": "string",
              "enum": [
                "yuan",
                "fen"
              ]
            }
          },
          "required": [
            "type",
            "value",
            "currency"
          ],
          "additionalProperties": false,
          "x-decimalRange": {
            "exclusiveMaximum": "100"
          }
        },
        "total": {
          "title": "总量",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "bigint"
            },
            "value": {
              "type": "string",
              "pattern": "^-?\\d+$"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "additionalProperties": false,
          "x-decimalRange": {
            "minimum": "1",
            "maximum": "99999999999999999999"
          }
        },
        "rate": {
          "title": "费率",
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "x-decimals": 2,
          "x-ui": {
            "thousands": true
          }
        },
        "count": {
          "title": "数量",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "price",
        "total"
      ]
    }
  }
}
