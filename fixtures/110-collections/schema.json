{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/Collections",
  "x-ui": {
    "version": 1
  },
  "$defs": {
    "Collections": {
      "title": "集合",
      "type": "object",
      "properties": {
        "i18n": {
          "title": "多语言",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "propertyNames": {
            "type": "string",
            "maxLength": 2,
            "pattern": "^[a-z]{2}$"
          }
        },
        "users": {
          "title": "用户表",
          "type": "object",
          "maxProperties": 10,
          "additionalProperties": {
            "type": "object",
            "properties": {
              "name": {
                "title": "姓名",
                "type": "string"
              },
              "age": {
                "title": "年龄",
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "name"
            ]
          },
          "x-ui": {
            "summary": "name"
          }
        },
        "point": {
          "title": "坐标",
          "type": "array",
          "minItems": 2,
          "prefixItems": [
            {
              "title": "经度",
              "type": "number"
            },
            {
              "title": "纬度",
              "type": "number"
            }
          ],
          "items": false
        },
        "record": {
          "title": "记录",
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "prefixItems": [
            {
              "title": "名称",
              "type": "string"
            }
          ],
          "items": {
            "type": "number"
          }
        },
        "extra": {
          "title": "扩展配置",
          "type": "string",
          "contentMediaType": "application/json"
        },
        "options": {
          "title": "选项",
          "type": "string",
          "contentMediaType": "application/json",
          "contentSchema": {
            "type": "object",
            "properties": {
              "debug": {
                "title": "调试",
                "type": "boolean"
              },
              "level": {
                "title": "级别",
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              }
            },
            "required": [
              "level"
            ]
          }
        },
        "matrix": {
          "title": "矩阵",
          "type": "string",
          "contentMediaType": "application/json",
          "contentSchema": {
            "type": "array",
            "items": {
              "type": "number"
            }
          }
        }
      },
      "required": [
        "point"
      ]
    }
  }
}
