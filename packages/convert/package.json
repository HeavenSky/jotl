{
  "name": "@jotl/convert",
  "version": "0.0.1",
  "license": "MIT",
  "type": "module",
  "description": "Turn JSON Schema into TypeScript declarations and back without losing constraints, and bring legacy JSON Schema, OpenAPI and Fengdie schemas up to JSON Schema 2020-12 and Jotl.",
  "repository": {
    "type": "git",
    "url": "https://github.com/HeavenSky/jotl.git",
    "directory": "packages/convert"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./from-ts": {
      "types": "./dist/from-ts.d.ts",
      "import": "./dist/from-ts.js"
    },
    "./eslint": {
      "types": "./dist/eslint.d.ts",
      "import": "./dist/eslint.js"
    },
    "./tsdoc.json": "./tsdoc.json"
  },
  "files": [
    "dist",
    "tsdoc.json"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck:test": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@jotl/core": "workspace:*",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@microsoft/tsdoc": "^0.17.1",
    "@microsoft/tsdoc-config": "^0.18.3",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "typia": "^15.1.0"
  }
}
