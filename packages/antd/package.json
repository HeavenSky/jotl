{
  "name": "@jotl/antd",
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "description": "Render Jotl forms with Ant Design components: one registry swaps the native widgets of @jotl/form for antd.",
  "repository": {
    "type": "git",
    "url": "https://github.com/jotl-lang/jotl.git",
    "directory": "packages/antd"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck:test": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@jotl/core": "workspace:*",
    "@jotl/form": "workspace:*"
  },
  "peerDependencies": {
    "antd": "^5.0.0 || ^6.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "antd": "^6.6.6",
    "jsdom": "^30.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
