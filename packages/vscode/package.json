{
	"name": "vscode-jotl",
	"displayName": "Jotl",
	"version": "0.0.2",
	"private": true,
	"description": "%extension.description%",
	"categories": [
		"Linters",
		"Programming Languages"
	],
	"keywords": [
		"form",
		"jotl",
		"json schema",
		"language server",
		"schema",
		"typescript",
		"x-ui"
	],
	"homepage": "https://github.com/HeavenSky/jotl/tree/HEAD/packages/vscode#readme",
	"bugs": {
		"url": "https://github.com/HeavenSky/jotl/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/HeavenSky/jotl.git",
		"directory": "packages/vscode"
	},
	"publisher": "heavensky",
	"files": [
		"dist/extension.cjs",
		"dist/server.cjs",
		"dist/preview.js",
		"dist/preview-form.css",
		"dist/preview-shim-react.js",
		"dist/preview-shim-react-jsx-runtime.js",
		"dist/preview-shim-react-dom.js",
		"dist/preview-shim-react-dom-client.js",
		"dist/x-ui.schema.json",
		"dist/jotl.config.schema.json",
		"dist/jotl.config.schema.zh-cn.json",
		"syntaxes",
		"language-configuration.json",
		"l10n",
		"media/icon.png",
		"package.nls.json",
		"package.nls.zh-cn.json",
		"LICENSE.txt",
		"CHANGELOG.md"
	],
	"type": "module",
	"main": "./dist/extension.cjs",
	"scripts": {
		"compile": "node build.mjs",
		"build": "node build.mjs --production",
		"watch": "node build.mjs --watch",
		"typecheck": "tsc -b && tsc -p tsconfig.test.json && tsc -p tsconfig.webview.json",
		"typecheck:test": "tsc -p tsconfig.test.json && tsc -p tsconfig.webview.json",
		"test": "vitest run",
		"check": "node scripts/check.mjs",
		"gen:icon": "node scripts/gen-icon.mjs",
		"package": "node scripts/package.mjs",
		"vscode:prepublish": "node build.mjs --production"
	},
	"dependencies": {},
	"devDependencies": {
		"@jotl/form": "workspace:*",
		"@jotl/language-server": "workspace:*",
		"@types/node": "^26.6.4",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vscode/vsce": "^4.0.0",
		"esbuild": "^0.28.2",
		"jsdom": "^30.1.2",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"typescript": "6.0.3",
		"vitest": "^5.0.3",
		"vscode-languageclient": "^10.1.2",
		"vscode-oniguruma": "^2.0.1",
		"vscode-textmate": "^9.3.2",
		"vscode-types": "npm:@types/vscode@^1.140.0"
	},
	"l10n": "./l10n",
	"contributes": {
		"languages": [
			{
				"id": "jotl",
				"aliases": [
					"Jotl",
					"jotl"
				],
				"extensions": [
					".jotl"
				],
				"configuration": "./language-configuration.json"
			}
		],
		"grammars": [
			{
				"language": "jotl",
				"scopeName": "source.jotl",
				"path": "./syntaxes/jotl.tmLanguage.json"
			}
		],
		"commands": [
			{
				"command": "jotl.showPreview",
				"title": "%command.showPreview%",
				"category": "%category%",
				"icon": "$(open-preview)"
			}
		],
		"menus": {
			"editor/title": [
				{
					"command": "jotl.showPreview",
					"when": "editorLangId == jotl",
					"group": "navigation"
				}
			],
			"commandPalette": [
				{
					"command": "jotl.showPreview",
					"when": "editorLangId == jotl"
				}
			]
		},
		"jsonValidation": [
			{
				"fileMatch": "*.schema.json",
				"url": "./dist/x-ui.schema.json"
			},
			{
				"fileMatch": "jotl.config.json",
				"url": "%jsonValidation.configSchema%"
			}
		],
		"configuration": {
			"title": "Jotl",
			"properties": {
				"jotl.registeredWidgets": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [],
					"description": "%config.registeredWidgets%"
				},
				"jotl.preview.loadWidgetModules": {
					"type": "boolean",
					"default": false,
					"description": "%config.preview.loadWidgetModules%"
				}
			}
		}
	},
	"icon": "media/icon.png",
	"engines": {
		"node": ">=22.15.1",
		"vscode": "^1.101.0"
	},
	"capabilities": {
		"untrustedWorkspaces": {
			"supported": "limited",
			"description": "%capabilities.untrustedWorkspaces%",
			"restrictedConfigurations": [
				"jotl.preview.loadWidgetModules"
			]
		}
	}
}
