{
  "name": "jotl",
  "version": "0.0.0",
  "description": "Compile Jotl to JSON Schema and TypeScript, validate JSON data, and migrate legacy schemas from the terminal or CI.",
  "repository": {
    "type": "git",
    "url": "https://github.com/jotl-lang/jotl.git",
    "directory": "packages/cli"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "jotl": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck:test": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@jotl/core": "workspace:*",
    "@jotl/convert": "workspace:*",
    "@jotl/data": "workspace:*"
  }
}
