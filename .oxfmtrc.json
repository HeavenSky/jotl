{
	"$schema": "https://unpkg.com/oxfmt/configuration_schema.json",
	"arrowParens": "avoid",
	"ignorePatterns": [
		"*.min.*",
		"fixtures/**",
		"packages/*/test/fixtures/**",
		"packages/form/style.css"
	],
	"jsxSingleQuote": false,
	"objectWrap": "collapse",
	"singleQuote": false,
	"tabWidth": 4,
	"trailingComma": "es5",
	"useTabs": true
}
